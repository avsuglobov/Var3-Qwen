# Этап 19: пример окружения для запуска. Скопируйте в .env (docker compose читает его автоматически)
# или задайте переменные прямо в docker-compose.yml / systemd-юните.
# Секреты (ключи интеграций, SMTP, учётные записи входа) в env НЕ задаются — они хранятся
# сервером в .data/secrets.json и в браузер уходят только маской (этапы 10, 16, 18).

# Порт и адрес слушателя (standalone-сервер Next, Dockerfile этапа 19)
PORT=3000
HOSTNAME=0.0.0.0

# Каталог изменяемого состояния: база, secrets.json, журнал интеграций.
# В docker-compose монтируется как volume: ./.data:/app/.data
AIWS_DATA_DIR=.data

# Драйвер хранилища: sqlite — прод (этап 17), file — dev/e2e (.data/db.json)
AIWS_DB_DRIVER=sqlite

# Панель сбоев /api/debug: "1" — включена (dev, тесты, e2e); пусто/не задано — выключена,
# маршруты отвечают 404 (прод-режим, этап 19)
AIWS_DEBUG=

# Телеметрия Next.js — отключена
NEXT_TELEMETRY_DISABLED=1
