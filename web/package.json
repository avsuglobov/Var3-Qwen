{
  "name": "ai-workspace-web",
  "version": "0.1.0",
  "private": true,
  "description": "AI Workspace — Next.js-версия (этап 1: каркас). Прототип лежит в ../download и служит спецификацией.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:colors": "node scripts/check-hardcoded-colors.mjs",
    "e2e": "npm run e2e:shell && npm run e2e:overview && npm run e2e:agents",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:colors",
    "e2e:overview": "node e2e/overview.check.mjs",
    "e2e:shell": "node e2e/shell.check.mjs",
    "e2e:agents": "node e2e/agents.check.mjs",
    "gen:seed": "node scripts/gen-seed.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.0.0",
    "lucide-react": "^0.460.0",
    "next": "^15.0.0",
    "next-themes": "^0.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.5.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "playwright": "^1.48.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.1",
    "vite": "^8.3.8"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "engines": {
    "node": ">=22.12"
  }
